def load_dotenv(path: str | None = ...) -> bool: ...

class Credentials:
    # None solo cuando la instancia viene de `from_connection_string`.
    system: str | None
    user: str | None
    driver: str | None

    def __init__(self, *, system: str, user: str, password: str, driver: str | None = ...) -> None: ...
    @classmethod
    def from_env(cls, client_code: str, environment: str | None = ...) -> Self: ...
    @classmethod
    def from_dsn(cls, dsn: str) -> Self: ...
    @classmethod
    def from_connection_string(cls, dsn: str) -> Self: ...

class EngineOptions:
    pool_size: int
    login_timeout: int
    query_timeout: int
    batch_size: int
    max_workers: int
    min_rows_per_worker: int
    merge_chunk_size: int
    merge_max_workers: int
    stream_batch_size: int
    prefetch_batches: int
    decimal_mode: DecimalMode
    strip_char_padding: bool
    def __init__(self, **kwargs: Any) -> None: ...
    @classmethod
    def from_env(cls) -> Self: ...

class RustOdbcError(Exception):
    message: str
    sqlstate: str | None
    native_code: int | None
class ConfigurationError(RustOdbcError): ...
class ConnectError(RustOdbcError): ...
class PoolTimeout(ConnectError): ...
class InterfaceError(RustOdbcError): ...
class QueryError(RustOdbcError): ...
class SqlSyntaxError(QueryError): ...
class IntegrityError(QueryError): ...
class DataError(QueryError): ...
class OperationTimeout(QueryError): ...
