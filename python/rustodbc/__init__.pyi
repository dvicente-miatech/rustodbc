from collections.abc import AsyncIterator, Mapping, Sequence
from decimal import Decimal
from datetime import date, datetime, time
from types import TracebackType
from typing import Any, Literal, Self, TypeAlias

__version__: str

Value: TypeAlias = str | int | float | Decimal | bool | bytes | date | time | datetime | None
Row: TypeAlias = dict[str, Value]
Params: TypeAlias = Sequence[Value] | Mapping[str, Value] | None
DecimalMode: TypeAlias = Literal["decimal", "str", "float"]
NoPkPolicy: TypeAlias = Literal["insert", "error"]

