# ------------------------------- rustodbc.blocking ---------------------------
# Se importa por submodulo explicito: `from rustodbc.blocking import BlockingEngine`.

class BlockingEngine:
    @staticmethod
    def connect(credentials: Credentials, options: EngineOptions | None = ...) -> Self: ...
    @staticmethod
    def from_env(client_code: str, environment: str | None = ...,
                 options: EngineOptions | None = ...) -> Self: ...
    def close(self) -> None: ...
    def execute(self, sql: str, params: Params = ...) -> int: ...
    def fetch_all(self, sql: str, params: Params = ...) -> list[Row]: ...
    def fetch_one(self, sql: str, params: Params = ...) -> Row | None: ...
    def fetch_value(self, sql: str, params: Params = ...) -> Value: ...
    def fetch_column(self, sql: str, params: Params = ...) -> list[Value]: ...
    def stream(self, sql: str, params: Params = ...,
               batch_size: int | None = ...) -> "BlockingBatchStream": ...
    def executebatch(self, sql: str, rows: Sequence[Sequence[Value]]) -> BulkReport: ...
    def call_proc(self, schema: str, proc: str,
                  params: Mapping[str, Value] | None = ...) -> "ProcResult": ...
    def table_sync(self, source: "BlockingEngine | None" = ...) -> "TableSync": ...

class BlockingBatchStream:
    @property
    def columns(self) -> list[str]: ...
    def __iter__(self) -> "BlockingBatchStream": ...
    def __next__(self) -> list[Row]: ...
