class Db2iEngine:
    @staticmethod
    async def connect(credentials: Credentials, options: EngineOptions | None = ...) -> Self: ...
    @staticmethod
    async def from_env(client_code: str, environment: str | None = ...,
                       options: EngineOptions | None = ...) -> Self: ...
    def close(self) -> None: ...
    async def __aenter__(self) -> Self: ...
    async def __aexit__(self, et: type[BaseException] | None, e: BaseException | None,
                         tb: TracebackType | None) -> bool: ...
    async def execute(self, sql: str, params: Params = ...) -> int: ...
    async def fetch_all(self, sql: str, params: Params = ...) -> list[Row]: ...
    async def fetch_one(self, sql: str, params: Params = ...) -> Row | None: ...
    async def fetch_value(self, sql: str, params: Params = ...) -> Value: ...
    async def fetch_column(self, sql: str, params: Params = ...) -> list[Value]: ...
    def stream_batches(self, sql: str, params: Params = ...,
                        batch_size: int | None = ...) -> "BatchStream": ...
    def stream(self, sql: str, params: Params = ...,
               batch_size: int | None = ...) -> "BatchStream": ...
    async def executebatch(self, sql: str, rows: Sequence[Sequence[Value]]) -> BulkReport: ...
    async def call_proc(self, schema: str, proc: str,
                         params: Mapping[str, Value] | None = ...) -> "ProcResult": ...
    def table_sync(self, source: "Db2iEngine | None" = ...) -> "TableSync": ...

class BatchStream:
    @property
    def columns(self) -> list[str]: ...
    def __aiter__(self) -> "BatchStream": ...
    async def __anext__(self) -> list[Row]: ...
    async def __aenter__(self) -> "BatchStream": ...
    async def __aexit__(self, et: type[BaseException] | None, e: BaseException | None,
                         tb: TracebackType | None) -> None: ...
    def cancel(self) -> None: ...
    async def aclose(self) -> None: ...

class BulkReport:
    rows_affected: int
    batches: int

class TaskFailure:
    index: int
    error: str

class ParallelReport:
    rows_affected: int
    failures: list[TaskFailure]

def plan_concurrency(total_rows: int, min_rows_per_worker: int, max_workers: int) -> int: ...

class ProcResult:
    result_sets: list[list[Row]]
    out_params: dict[str, Value]

class MergeReport:
    rows_affected: int
    batches: int
    used_merge: bool
    warning: str | None

class TableSync:
    async def merge(self, schema: str, table: str, records: Sequence[Row],
                     primary_key: Sequence[str] | None = ...) -> MergeReport: ...
    def merge_sync(self, schema: str, table: str, records: Sequence[Row],
                   primary_key: Sequence[str] | None = ...) -> MergeReport: ...

